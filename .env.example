# Healdar — environment variables
# Copy this file to .env and fill in your values. NEVER commit .env.

# ── Required ─────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── Models (optional) ────────────────────────────────────────────────────
# Groq retires models on a published schedule; when that happens every query
# fails at once. These let you switch without a code change.
# See https://console.groq.com/docs/deprecations
#
# GROQ_MODEL_ANSWER  writes the regulatory answer (quality matters most)
# GROQ_MODEL_LARGE   translates the finished answer into Arabic
# GROQ_MODEL         cheap, high-throughput: query translation, follow-up rewrite
#GROQ_MODEL_ANSWER=openai/gpt-oss-120b
#GROQ_MODEL_LARGE=openai/gpt-oss-120b
#GROQ_MODEL=openai/gpt-oss-20b
#GROQ_TIMEOUT=45
#GROQ_MAX_RETRIES=2

# ── Retrieval tuning (optional) ──────────────────────────────────────────
# HEALDAR_MAX_DISTANCE is the relevance gate. Measured on this corpus:
# on-topic best matches <= 0.40, off-topic >= 0.66. The default sits in
# the gap. Raising it makes the assistant answer from weaker material;
# lowering it makes it refuse more often.
#HEALDAR_MAX_DISTANCE=0.53
#HEALDAR_WEAK_DISTANCE=0.45
#HEALDAR_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2  # rebuild after changing
#HEALDAR_TOP_K=5
#HEALDAR_CANDIDATE_K=20
#HEALDAR_HYBRID=1          # BM25 alongside dense search
#HEALDAR_QUERY_EXPANSION=1 # spell out acronyms (AI, SaMD, PDPL...) before searching
#HEALDAR_QUERY_PLANNING=1  # model names the rules a question depends on; each is searched too
#HEALDAR_PLANNED_QUERIES=3
#GROQ_MODEL_PLANNER=openai/gpt-oss-120b
#GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b,openai/gpt-oss-20b  # backups, in turn, when the main model's daily allowance runs out; "none" = off
#HEALDAR_HISTORY_TURNS=3          # conversation turns a follow-up sees
#HEALDAR_HISTORY_ANSWER_CHARS=2400 # of the latest answer: its opening and conclusion
#HEALDAR_CARRY_SOURCES=3          # pages the previous answer cited, carried into a follow-up
#HEALDAR_MAX_PER_JX=2      # cap per jurisdiction in "all" mode

# ── Behaviour (optional) ─────────────────────────────────────────────────
#HEALDAR_DEV=1                    # hot-reload rag_pipeline on every rerun
#HEALDAR_AUTO_REBUILD=1           # rebuild a corrupt index from chunks.json

# Persist chat history to disk. OFF by default: the file is process-wide, so
# on a shared deployment one visitor would see the previous visitor's history.
#HEALDAR_PERSIST_SESSION=0

# Store raw question text in the analytics DB. OFF by default — questions can
# contain personal or commercially sensitive detail.
#HEALDAR_ANALYTICS_QUESTIONS=0

# Per-session throttle, so a public deployment cannot drain the API quota.
# 0 disables it.
#HEALDAR_RATE_LIMIT_QUERIES=0
#HEALDAR_RATE_LIMIT_WINDOW=600

# ── Local runs ───────────────────────────────────────────────────────────
# Set by run.bat / run.sh. Skips HuggingFace Hub network checks when the
# embedding model is already cached. Leave UNSET on HuggingFace Spaces so the
# model can download on cold start.
#HF_HUB_OFFLINE=1
