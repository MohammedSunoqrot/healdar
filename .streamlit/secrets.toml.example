# .streamlit/secrets.toml — Streamlit Cloud secret management
#
# HOW TO USE:
#   1. Copy this file to .streamlit/secrets.toml  (local dev)
#   2. On Streamlit Cloud: paste contents into App Settings → Secrets
#
# NEVER commit secrets.toml to Git. Add it to .gitignore.

GROQ_API_KEY = "gsk_your_key_here"
