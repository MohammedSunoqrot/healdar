# Development / local environment
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
tests/
eval/
docs/
scripts/

# Secrets — never copy into the image
.env
.streamlit/secrets.toml

# Runtime data (per-deployment; must not be baked in)
data/runtime/

# Source PDFs — the vector store and chunks.json are the shipped artefacts
data/raw_docs/

# Local OS / editor artefacts
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/

# Git
.git/
.gitattributes
.gitignore
.github/

# Windows launch script (not needed in a Linux container)
run.bat
